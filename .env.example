# HydraClaw Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── AI Provider API Keys ──────────────────────────────────
# Only set the keys for providers you want to use.
# For local providers (Ollama, LM Studio, vLLM) no keys are needed.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# MISTRAL_API_KEY=...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# DEEPSEEK_API_KEY=sk-...
# XAI_API_KEY=xai-...
# PERPLEXITY_API_KEY=pplx-...
# COHERE_API_KEY=...

# ── Local Provider URLs (optional overrides) ──────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# VLLM_BASE_URL=http://localhost:8000/v1

# ── Docker: Ollama on host machine ───────────────────────
# When running HydraClaw in Docker with Ollama on the host,
# use host.docker.internal instead of localhost:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ── Channel Tokens ────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# MATRIX_ACCESS_TOKEN=...
# TWITTER_APP_KEY=...
# TWITTER_APP_SECRET=...
# TWITTER_ACCESS_TOKEN=...
# TWITTER_ACCESS_SECRET=...
# MASTODON_ACCESS_TOKEN=...
# BLUESKY_PASSWORD=...
# LINE_CHANNEL_TOKEN=...
# LINE_CHANNEL_SECRET=...
# TEAMS_APP_ID=...
# TEAMS_APP_PASSWORD=...
# ZALO_OA_ID=...
# ZALO_SECRET_KEY=...
# ZALO_ACCESS_TOKEN=...

# ── Other ─────────────────────────────────────────────────
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
# REDDIT_USERNAME=...
# REDDIT_PASSWORD=...
# EMAIL_USER=...
# EMAIL_PASSWORD=...
# XMPP_PASSWORD=...

# ── Runtime Settings ──────────────────────────────────────
# NODE_ENV=production
# LOG_LEVEL=info
