# HydraClaw Environment Variables
# Copy this file to .env and fill in your credentials

# === AI Providers ===

# OpenRouter (recommended - access 200+ models with one key)
OPENROUTER_API_KEY=

# Direct provider keys (optional if using OpenRouter)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# === Messaging Channels ===
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
MATRIX_ACCESS_TOKEN=
EMAIL_USER=
EMAIL_PASSWORD=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
TWITTER_APP_KEY=
TWITTER_APP_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
MASTODON_ACCESS_TOKEN=
BLUESKY_PASSWORD=
XMPP_PASSWORD=
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
ZALO_OA_ID=
ZALO_SECRET_KEY=
ZALO_ACCESS_TOKEN=

# === System ===
LOG_LEVEL=info
NODE_ENV=development
HYDRACLAW_CONFIG=./config.yaml
